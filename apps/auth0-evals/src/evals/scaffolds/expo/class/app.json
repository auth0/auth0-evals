{
  "expo": {
    "name": "Barkbook",
    "slug": "barkbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.barkbook.app"
    },
    "android": {
      "package": "com.barkbook.app"
    },
    "plugins": [
      "expo-dev-client",
      [
        "react-native-auth0",
        {
          "domain": "dev-barkbook.us.auth0.com",
          "customScheme": "barkbook"
        }
      ]
    ]
  }
}
